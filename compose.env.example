# Copy this file to .env for Docker Compose, then replace all passwords.
MYSQL_DATABASE=bangumi_recorder
MYSQL_USER=bangumi
MYSQL_PASSWORD=change-this-database-password
MYSQL_ROOT_PASSWORD=change-this-root-password
JWT_SECRET=replace-with-a-long-random-secret

# Optional application configuration
APP_PORT=8080
RUST_LOG=info
ALLOW_REGISTER=true
REGISTER_NEED_TOKEN=false
# REGISTER_TOKEN=
# OMDB_API_KEY=
# IMDB_SEARCH_MODE=no_api
